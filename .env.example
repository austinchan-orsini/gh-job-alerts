# ── Postgres ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml's postgres service. Run `docker compose up -d
# postgres` first, then this app connects from the host at localhost:5432.
DATABASE_URL=postgres://ghjobalerts:ghjobalerts@localhost:5432/ghjobalerts
# Set to "true" for managed Postgres hosts that require SSL (e.g. Railway's
# Postgres plugin over its public/proxy connection) — leave unset for the
# local Docker Compose Postgres, which doesn't support it.
DATABASE_SSL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for a per-repo poll lock (prevents double-polling if you ever run more
# than one app replica) and a short-TTL dashboard read cache.
REDIS_URL=redis://localhost:6379

# ── AWS SQS (job-alert queue) ─────────────────────────────────────────────────
# Locally, AWS_ENDPOINT_URL points at LocalStack (docker-compose.yml's
# localstack service) so the queue is free and runs entirely on your
# machine — no AWS account needed. In production (e.g. Railway, which can't
# run LocalStack for you), leave AWS_ENDPOINT_URL unset and use a real AWS
# SQS queue instead — SQS's free tier (1M requests/month) never expires, so
# this stays $0 at this app's volume. Same code either way.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
JOB_ALERTS_QUEUE_NAME=job-alerts
# Run `npm run setup:queue` (locally against LocalStack, or with real AWS
# credentials and AWS_ENDPOINT_URL unset) to create it. The app resolves the
# queue's URL by name at runtime, so you normally don't need to set this —
# only for pointing at a specific queue by its full URL instead.
JOB_ALERTS_QUEUE_URL=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token — raises rate limit from 60 → 5,000 req/hour
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here

# ── Twilio ────────────────────────────────────────────────────────────────────
# Find these at: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio phone number
TWILIO_TO_NUMBER=+15559876543     # Your personal cell number

# ── Discord webhook (optional) ───────────────────────────────────────────────
# Create a webhook: Discord server → Edit Channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# ── Discord bot (multi-server, optional) ─────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Bot tab → Reset Token → copy here. No privileged intents required.
DISCORD_BOT_TOKEN=your_bot_token_here

# General tab → Application ID (Client ID) — used for the invite link and
# slash command registration.
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register slash commands to a single guild for instant propagation
# during development (global registration can take up to 1 hour to appear).
DISCORD_DEV_GUILD_ID=

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to check repos (cron syntax). Default: every 10 minutes.
# See https://crontab.guru for help building expressions.
POLL_CRON=*/10 * * * *

# ── Daily digest ──────────────────────────────────────────────────────────────
# When to send the once-a-day "no new postings" summary (cron syntax, UTC).
# Default: 1pm UTC daily.
DIGEST_CRON=0 13 * * *

# ── Web UI ────────────────────────────────────────────────────────────────────
PORT=3000
